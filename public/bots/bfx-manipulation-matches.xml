<xml xmlns="https://developers.google.com/blockly/xml" is_dbot="true" collection="false">
  <variables>
    <variable id="matches-stake">Stake</variable>
    <variable id="matches-initial">Initial stake</variable>
    <variable id="matches-multiplier">Martingale multiplier</variable>
    <variable id="matches-take-profit">Take profit</variable>
    <variable id="matches-stop-loss">Stop loss</variable>
    <variable id="matches-prediction">Prediction digit</variable>
  </variables>
  <block type="trade_definition" id="matches-trade" deletable="false" x="0" y="40">
    <statement name="TRADE_OPTIONS">
      <block type="trade_definition_market" id="matches-market" deletable="false" movable="false">
        <field name="MARKET_LIST">synthetic_index</field><field name="SUBMARKET_LIST">random_index</field><field name="SYMBOL_LIST">R_100</field>
        <next><block type="trade_definition_tradetype" id="matches-tradetype" deletable="false" movable="false">
          <field name="TRADETYPECAT_LIST">digits</field><field name="TRADETYPE_LIST">matchesdiffers</field>
          <next><block type="trade_definition_contracttype" id="matches-contract" deletable="false" movable="false">
            <field name="TYPE_LIST">DIGITMATCH</field>
            <next><block type="trade_definition_candleinterval" id="matches-interval" deletable="false" movable="false">
              <field name="CANDLEINTERVAL_LIST">60</field>
              <next><block type="trade_definition_restartbuysell" id="matches-restart" deletable="false" movable="false">
                <field name="TIME_MACHINE_ENABLED">FALSE</field>
                <next><block type="trade_definition_restartonerror" id="matches-errors" deletable="false" movable="false"><field name="RESTARTONERROR">FALSE</field></block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="INITIALIZATION">
      <block type="variables_set" id="set-initial">
        <field name="VAR" id="matches-initial">Initial stake</field><value name="VALUE"><block type="math_number" id="initial-value"><field name="NUM">1</field></block></value>
        <next><block type="variables_set" id="set-stake">
          <field name="VAR" id="matches-stake">Stake</field><value name="VALUE"><block type="variables_get" id="get-initial-start"><field name="VAR" id="matches-initial">Initial stake</field></block></value>
          <next><block type="variables_set" id="set-multiplier">
            <field name="VAR" id="matches-multiplier">Martingale multiplier</field><value name="VALUE"><block type="math_number" id="multiplier-value"><field name="NUM">2</field></block></value>
            <next><block type="variables_set" id="set-take-profit">
              <field name="VAR" id="matches-take-profit">Take profit</field><value name="VALUE"><block type="math_number" id="take-profit-value"><field name="NUM">10</field></block></value>
              <next><block type="variables_set" id="set-stop-loss">
                <field name="VAR" id="matches-stop-loss">Stop loss</field><value name="VALUE"><block type="math_number" id="stop-loss-value"><field name="NUM">10</field></block></value>
                <next><block type="variables_set" id="set-prediction">
                  <field name="VAR" id="matches-prediction">Prediction digit</field><value name="VALUE"><block type="math_number" id="prediction-value"><field name="NUM">4</field></block></value>
                </block></next>
              </block></next>
            </block></next>
          </block></next>
        </block></next>
      </block>
    </statement>
    <statement name="SUBMARKET"><block type="trade_definition_tradeoptions" id="matches-options">
      <mutation xmlns="http://www.w3.org/1999/xhtml" has_first_barrier="false" has_second_barrier="false" has_prediction="true"></mutation>
      <field name="DURATIONTYPE_LIST">t</field>
      <value name="DURATION"><shadow type="math_number_positive" id="duration-shadow"><field name="NUM">1</field></shadow></value>
      <value name="AMOUNT"><shadow type="math_number_positive" id="amount-shadow"><field name="NUM">1</field></shadow><block type="variables_get" id="get-stake"><field name="VAR" id="matches-stake">Stake</field></block></value>
      <value name="PREDICTION"><shadow type="math_number_positive" id="prediction-shadow"><field name="NUM">4</field></shadow><block type="variables_get" id="get-prediction"><field name="VAR" id="matches-prediction">Prediction digit</field></block></value>
    </block></statement>
  </block>
  <block type="before_purchase" id="matches-before" x="700" y="40"><statement name="BEFOREPURCHASE_STACK">
    <block type="purchase" id="matches-buy"><field name="PURCHASE_LIST">DIGITMATCH</field></block>
  </statement></block>
  <block type="after_purchase" id="matches-after" x="700" y="180"><statement name="AFTERPURCHASE_STACK">
    <block type="controls_if" id="matches-result" inline="false"><mutation xmlns="http://www.w3.org/1999/xhtml" else="1"></mutation>
      <value name="IF0"><block type="contract_check_result" id="matches-won"><field name="CHECK_RESULT">win</field></block></value>
      <statement name="DO0"><block type="variables_set" id="reset-stake"><field name="VAR" id="matches-stake">Stake</field><value name="VALUE"><block type="variables_get" id="reset-stake-value"><field name="VAR" id="matches-initial">Initial stake</field></block></value></block></statement>
      <statement name="ELSE"><block type="variables_set" id="raise-stake"><field name="VAR" id="matches-stake">Stake</field><value name="VALUE"><block type="math_arithmetic" id="stake-times-multiplier"><field name="OP">MULTIPLY</field>
        <value name="A"><shadow type="math_number" id="stake-shadow"><field name="NUM">1</field></shadow><block type="variables_get" id="current-stake"><field name="VAR" id="matches-stake">Stake</field></block></value>
        <value name="B"><shadow type="math_number" id="multiplier-shadow"><field name="NUM">2</field></shadow><block type="variables_get" id="current-multiplier"><field name="VAR" id="matches-multiplier">Martingale multiplier</field></block></value>
      </block></value></block></statement>
      <next><block type="controls_if" id="check-take-profit"><mutation xmlns="http://www.w3.org/1999/xhtml" elseif="1" else="1"></mutation>
        <value name="IF0"><block type="logic_compare" id="profit-reached"><field name="OP">GTE</field><value name="A"><block type="total_profit" id="profit-value"></block></value><value name="B"><block type="variables_get" id="tp-value"><field name="VAR" id="matches-take-profit">Take profit</field></block></value></block></value>
        <statement name="DO0"><block type="text_print" id="tp-message"><value name="TEXT"><shadow type="text" id="tp-shadow"><field name="TEXT">Take profit reached. Bot stopped.</field></shadow></value></block></statement>
        <value name="IF1"><block type="logic_compare" id="loss-reached"><field name="OP">LTE</field><value name="A"><block type="total_profit" id="loss-value"></block></value><value name="B"><block type="math_arithmetic" id="negative-stop"><field name="OP">MULTIPLY</field><value name="A"><block type="variables_get" id="sl-value"><field name="VAR" id="matches-stop-loss">Stop loss</field></block></value><value name="B"><block type="math_number" id="minus-one"><field name="NUM">-1</field></block></value></block></value></block></value>
        <statement name="DO1"><block type="text_print" id="sl-message"><value name="TEXT"><shadow type="text" id="sl-shadow"><field name="TEXT">Stop loss reached. Bot stopped.</field></shadow></value></block></statement>
        <statement name="ELSE"><block type="trade_again" id="matches-again"></block></statement>
      </block></next>
    </block>
  </statement></block>
</xml>