{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/callback",
      "destination": "/api/handler?path=deriv/callback"
    },
    {
      "source": "/api/:path*",
      "destination": "/api/handler?path=:path*"
    }
  ],
  "functions": {
    "api/handler.mjs": {
      "maxDuration": 30
    }
  }
}
